{
  "manifest_version": 3,
  "name": "Handshake CyberCareer Advisor",
  "version": "1.0.0",
  "description": "Chrome extension for Computer Science students transitioning to Cybersecurity on Handshake: automatic job scraping, Gemini match scoring, and tailored cover letter generation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.joinhandshake.com/*",
    "https://*.joinhandshake.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Cybersecurity Job Fit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.joinhandshake.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
